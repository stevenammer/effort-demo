{
  "name": "effort-demo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A synthetic browser walkthrough of E.F.F.O.R.T., using its existing deterministic organisation code.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test",
    "android:prepare": "node scripts/prepare-android-web.mjs",
    "test:android-shell": "node --test test/android-shell.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:core": "node scripts/sync-core.mjs --check && node scripts/sync-helpers.mjs --check",
    "check:mutations": "node scripts/mutate-check.mjs",
    "helper": "node scripts/helper-companion.mjs"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "ajv": "8.18.0",
    "fake-indexeddb": "6.2.7"
  }
}
